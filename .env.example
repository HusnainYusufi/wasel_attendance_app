# ---------------------------------------------------------------------------
# Wasel Attendance — environment
#
# Copy to .env and fill in. Every variable is validated at boot: the API exits
# with an aggregated list of problems rather than starting half-configured.
# Variables marked (optional) have working defaults and may be omitted.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# (optional) Bind address. Default 0.0.0.0 — set 127.0.0.1 to bind loopback only.
HOST=0.0.0.0

# Comma-separated allowlist of origins permitted to call the API.
# Must NOT be "*" when NODE_ENV=production — the API refuses to boot.
# For a Capacitor Android build, include: https://localhost,capacitor://localhost
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://wasel:wasel_dev_password@localhost:5432/wasel_attendance?schema=public
# Used only by the integration test suite. Port 5434 (5433 is often taken).
TEST_DATABASE_URL=postgresql://wasel:wasel_test_password@localhost:5434/wasel_attendance_test?schema=public

# (optional) Connection pool. Keep POOL_MAX below your Postgres max_connections
# divided by the number of API replicas, or a rolling deploy will exhaust it.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Authentication
#
# Minimum 32 chars each, and the two MUST differ — a shared key would let a
# refresh token verify as an access token. Generate with:
#   openssl rand -base64 48
# The placeholders below are rejected outright when NODE_ENV=production.
# ---------------------------------------------------------------------------

JWT_ACCESS_SECRET=change-me-dev-only-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret-min-32-chars
# (optional) Duration form: 15m, 24h, 30d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# (optional) Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Rate limiting & request handling
# ---------------------------------------------------------------------------

# (optional) Global throttle: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# (optional) Express `trust proxy`, as a HOP COUNT — the number of proxies in
# front of the API. Never set this higher than the real number of hops: each
# extra hop lets a client forge the client IP in X-Forwarded-For, which would
# poison the audit log and defeat per-IP rate limiting. 0 = no proxy.
TRUST_PROXY_HOPS=0

# (optional) Max JSON body size, e.g. 256kb
BODY_LIMIT=256kb

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# (optional) Human-readable log output. Defaults to on outside production.
# LOG_PRETTY=true

# (optional) Swagger UI. Defaults to enabled outside production. Enabling it in
# production publishes your full API surface — do so deliberately.
# SWAGGER_ENABLED=false
SWAGGER_PATH=/api/docs

# ---------------------------------------------------------------------------
# Seed data (used by `pnpm db:seed` only)
#
# Creates the organization and its first admin. CHANGE THE PASSWORD immediately
# after the first sign-in — these values live in your shell history and .env.
# ---------------------------------------------------------------------------

SEED_ADMIN_EMAIL=admin@wasel.app
SEED_ADMIN_PASSWORD=Admin123!Change
SEED_ORG_NAME=Wasel
SEED_ORG_TIMEZONE=Asia/Riyadh
