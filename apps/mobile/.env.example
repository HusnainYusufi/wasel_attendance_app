# Absolute base URL of the Wasel API, including the /api/v1 prefix.
# On a device this MUST be reachable from the handset — `localhost` there is the
# phone itself, not your laptop.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Browser-only convenience: with VITE_API_BASE_URL=/api/v1 the Vite dev server
# proxies to this origin, sidestepping CORS during local development.
VITE_DEV_API_PROXY_TARGET=http://localhost:3000

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000
