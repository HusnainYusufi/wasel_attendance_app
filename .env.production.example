# ---------------------------------------------------------------------------
# Wasel Attendance — production environment
#
#   cp .env.production.example .env.production   (then fill it in)
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# .env.production is gitignored. Keep it off git and back it up somewhere
# private — losing JWT_ACCESS_SECRET signs every user out; losing
# POSTGRES_PASSWORD locks you out of the data.
#
# The API validates all of this at boot and EXITS on anything invalid, rather
# than starting half-configured. A failed start is a working alarm.
# ---------------------------------------------------------------------------

# --- The hostname the mobile app will call ---------------------------------
# Must be a real hostname, not a bare IP: certificate authorities do not issue
# for IP addresses, and Android refuses cleartext HTTP. With no domain of your
# own, use wildcard DNS that resolves to your server — replace the digits with
# your IP and Caddy gets a genuine Let's Encrypt certificate for it:
#     DOMAIN=203.0.113.10.sslip.io
DOMAIN=attendance.example.com

# Optional but recommended: Let's Encrypt emails you before a renewal failure
# would expire your certificate.
ACME_EMAIL=you@example.com

# --- Database --------------------------------------------------------------
# Not published to the host; reachable only from the API container.
POSTGRES_USER=wasel
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
POSTGRES_DB=wasel_attendance

# --- Authentication --------------------------------------------------------
# At least 32 characters each, and they MUST differ — a shared key would let a
# refresh token verify as an access token, collapsing the whole revocation
# design. Generate each with:
#     openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_openssl_rand_base64_48

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS ------------------------------------------------------------------
# The origins the app actually calls from. A Capacitor Android build sends
# https://localhost or capacitor://localhost. Add your web origin only if you
# also serve the PWA. "*" is refused outright in production.
CORS_ORIGINS=https://localhost,capacitor://localhost

# --- Operations ------------------------------------------------------------
LOG_LEVEL=info

# Publishing your full API surface unauthenticated is a deliberate act, so this
# defaults to off in production. Turn it on only while debugging.
SWAGGER_ENABLED=false

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Keep below your Postgres max_connections divided by the number of API
# replicas, or a rolling deploy exhausts the pool.
DATABASE_POOL_MAX=10

# --- First admin (used by `pnpm db:seed` only) -----------------------------
# The seed refuses to run against a production database with the example
# password, and requires NODE_ENV to be set explicitly.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_base64_24
SEED_ORG_NAME=Your Company
SEED_ORG_TIMEZONE=Asia/Riyadh
